{
  "name": "cyber-vanguard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cyber Vanguard: action-platformer 2D (Phaser 3 + TypeScript + Vite)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "predev": "npm run sync-data",
    "dev": "vite",
    "prebuild": "npm run sync-data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate-check": "node scripts/gate-check.mjs",
    "gate-flow": "node scripts/gate-flow.mjs",
    "docs-check": "node scripts/docs-check.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/three": "^0.170.0",
    "eslint": "10.14.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
